# Copy to .env.local and fill in. Never commit the real file.
# Only VITE_/NEXT_PUBLIC_-prefixed variables are exposed to the browser; every
# value below is server-only.

# ── Database ──────────────────────────────────────────────────────────────────
# Neon Postgres connection string (pooled endpoint recommended).
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# Optional escape hatch for restricted networks: dial a specific IP for the
# database host while still validating TLS against the real hostname. Leave
# unset in production — Neon's addresses rotate.
# DB_PINNED_HOST_IP=

# ── Secrets (generate with: openssl rand -base64 32) ──────────────────────────
# Encrypts TOTP secrets at rest. Rotating this invalidates all enrolled MFA.
MFA_ENCRYPTION_KEY=

# ── Rate limiting (optional) ──────────────────────────────────────────────────
# Redis endpoint for authentication rate-limit counters. Any standard Redis
# works — self-hosted, Upstash TCP, Vercel KV, Railway — via redis:// or
# rediss://. Unset, counters fall back to the auth_attempts table in Postgres,
# which is correct but puts write-heavy throwaway counters on the primary.
# If Redis is configured but unreachable, the limiter falls back rather than
# failing open.
# REDIS_URL=rediss://default:password@host:6379

# Used only by the test suite; when unset the Redis tests are skipped.
# TEST_REDIS_URL=redis://127.0.0.1:6379

# Database for the test suite. The tests create and delete rows, so point this
# at a disposable database or a Neon branch rather than one people use. Unset,
# the tests fall back to DATABASE_URL.
# TEST_DATABASE_URL=

# ── App ───────────────────────────────────────────────────────────────────────
# Public origin. Used for CSRF origin checks and password-reset links, so it
# must match the deployed URL exactly (no trailing slash). Required in production.
APP_URL=http://localhost:3000

# Which edge is trusted to have set the geo headers used by session anomaly
# detection: "vercel", "cloudflare", or unset.
#
# Leave unset unless the app is actually deployed behind one. Geo arrives as
# request headers, and both platforms overwrite their own at the edge — behind
# anything else a caller can state its own location and walk past the travel
# detector. Unset, travel detection is inert and says so; volume and
# privilege-escalation detection are unaffected.
ANOMALY_TRUSTED_PROXY=

# ── Payments ──────────────────────────────────────────────────────────────────
# No payment provider is integrated. Only when this is 'true' does checkout
# record orders as paid into escrow (the demo). Anything else: checkout is
# refused rather than telling farmers money is held when it is not.
SIMULATED_PAYMENTS=true
