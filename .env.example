# Copy to .env (or .env.production) and fill in. Never commit the real .env.
# Only VITE_-prefixed variables are exposed to the client build.

# Public base URL of the deployed site, no trailing slash.
# Used to build absolute og:image / twitter:image URLs for social link previews.
# Leave unset and those tags fall back to root-relative paths, which still work
# locally but are less reliable across crawlers.
VITE_SITE_URL=https://your-domain.example
