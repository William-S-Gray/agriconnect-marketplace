# Peer dependency resolution is pinned at the project level on purpose.
#
# A developer's global ~/.npmrc setting legacy-peer-deps=true silently produced
# a lock file that npm ci rejected in CI, and let a package with an
# incompatible peer range (eslint-config-next, which needs eslint 8) install
# without complaint. Committing the setting here means every machine and CI
# resolve identically, and a genuine peer conflict fails loudly instead of
# being papered over.
legacy-peer-deps=false
